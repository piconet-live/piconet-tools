<Project>
  <!-- Settings shared by every project in this repository. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Package metadata; the version is bumped deliberately. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <!-- The project's name, never a person's: an assembly's author and company travel in every program that
         carries a library of this repository. -->
    <Authors>Piconet</Authors>
    <Company>Piconet</Company>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
